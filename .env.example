# ============================================================
# 复制本文件为 .env.local（前端）/ 在部署平台配置同名环境变量（后端）
# 未配置时：前端走同源 /api，本地由 vite proxy 转发到 localhost:3001
# ============================================================

# ---- 前端（Vite，仅 VITE_ 前缀会注入浏览器）----
# 留空 = 同源 /api：本地由 vite proxy 转发；CloudBase 上把 HTTP 访问服务
#        的 /api/* 路由指向 english-api 云函数即可，三端零配置。
# 只有当云函数与网页不同域名时才填完整地址，例如：
# VITE_API_BASE=https://<env-id>.service.tcloudbase.com/api
VITE_API_BASE=

# ---- 腾讯云开发 CloudBase（免费版 3000 资源点/月）----
# 环境 ID：cloud1-d5giiwkzidd6e6c60（已写入 cloudbaserc.json，网关实测有效）
# 推荐部署：控制台「流水线管理」授权 GitHub 仓库 → 免 API 密钥、push 自动部署。
# 备用部署：.github/workflows/deploy.yml（需 TCB_SECRET_ID / TCB_SECRET_KEY / TCB_ENV_ID）。
# 下方 AUTH_SECRET 同时供 cloudbaserc.json 的 {{env.AUTH_SECRET}} 解析；
# 请在流水线「环境变量」或 Actions Secrets 里设置，切勿写进仓库。

# ---- 后端（进程环境变量，不进浏览器）----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=english_learning

# 生产环境必须改成随机长字符串，用于签名登录 token
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 可选：允许跨域的来源，逗号分隔；同源部署留空即可
CORS_ORIGIN=

# 可选：后端监听端口，默认 3001
PORT=3001
